# Database (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT Secret (generate a random string, e.g. openssl rand -base64 48)
# Required -- the server refuses to start without it.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Admin access is a property of the account, not a shared password. Register
# normally, then grant it in the database:
#   UPDATE users SET is_admin = TRUE WHERE username = 'yourname';
# The admin panel at /admin logs in with that account.

# Server
PORT=3000
NODE_ENV=production

# Frontend URL (your Railway app URL)
FRONTEND_URL=https://your-app-name.up.railway.app

# Email (optional - for email verification)
# If not set, email verification will be skipped
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
